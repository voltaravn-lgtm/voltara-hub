{
  "manifest_version": 3,
  "name": "Voltara Product Importer",
  "version": "1.3.12",
  "description": "Lấy thông tin sản phẩm từ Shopee và gửi về Voltara Product Hub.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "https://*.run.app/*",
    "https://*.vercel.app/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://shopee.vn/*",
    "https://*.facebook.com/*",
    "https://*.fbcdn.net/*",
    "https://*.fbsbx.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://shopee.vn/*",
        "https://*.facebook.com/*"
      ],
      "js": [
        "facebook-parser/facebookParserUtils.js",
        "facebook-parser/facebookParserDebug.js",
        "facebook-parser/facebookPostDetector.js",
        "facebook-parser/facebookPostTextParser.js",
        "facebook-parser/facebookPostMediaParser.js",
        "facebook-parser/facebookVideoParser.js",
        "facebook-parser/facebookPostAuthorParser.js",
        "facebook-parser/facebookPostUrlParser.js",
        "facebook-parser/facebookParser.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "options_page": "options.html"
}
